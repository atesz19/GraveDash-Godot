; Engine configuration file for GraveDash (Godot 4.4+, tested on 4.7.2).
; Auto-generated for the MVP player + chunk slice — do not hand-edit casually.
config_version=5

[application]

config/name="GraveDash"
config/description="Horror endless runner — Subway Surfers style, Android-first."
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.055, 0.04, 0.09, 1)
boot_splash/image="res://assets/icons/icon_512.png"
boot_splash/fullsize=false

[autoload]

SaveSystem="*res://autoload/SaveSystem.gd"
GameManager="*res://autoload/GameManager.gd"
ScoreManager="*res://autoload/ScoreManager.gd"
MissionManager="*res://autoload/MissionManager.gd"
ObjectPool="*res://autoload/ObjectPool.gd"
AudioManager="*res://autoload/AudioManager.gd"
BiomeManager="*res://autoload/BiomeManager.gd"
SkinManager="*res://autoload/SkinManager.gd"
UpgradeManager="*res://autoload/UpgradeManager.gd"
TouchSwipeDetector="*res://scripts/input/TouchSwipeDetector.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 4 = sensor landscape (Android landscape, allows 180° flip).
window/handheld/orientation=4

[input_devices]

; Lets desktop mouse-drag exercise TouchSwipeDetector without a device.
pointing/emulate_touch_from_mouse=true

[input]

swipe_left={
"deadzone": 0.5,
