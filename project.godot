[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="hazards"
3d_physics/layer_4="pickups"

[rendering]

; Mobile renderer — required path for Android (Vulkan mobile / OpenGL ES).
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
; Devices without Vulkan drop to the Compatibility (GLES3) renderer instead of failing to boot.
rendering_device/fallback_to_opengl3=true
environment/defaults/default_clear_color=Color(0.03, 0.025, 0.05, 1)
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size.mobile=2048

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[android]

; Package identity also mirrored in export_presets.cfg.
modules=""
